# Copy to .env and fill in your key:  cp .env.example .env
# .env is git-ignored. Never commit your real key.
KIRO_API_KEY=ksk_your_key_here

# Optional: default model id
# KIRO_MODEL=

# Optional: default reasoning effort (low, medium, high, xhigh, max).
# "max" is Claude-only; not all models support effort.
# KIRO_EFFORT=
